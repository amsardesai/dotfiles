#!/bin/bash

source "$SCRIPT_SOURCE/git-prompt.bash"
source "$SCRIPT_SOURCE/svn-prompt.bash"

# SVN
SVNP_HUGE_REPO_EXCLUDE_PATH="nufw-svn$|/tags$|/branches$"

# Shell prompt styled after the steeef oh-my-zsh theme, using Solarized colors.
# Heavily inspired by @necolas’s prompt: https://github.com/necolas/dotfiles

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
  export TERM='gnome-256color';
elif infocmp xterm-256color >/dev/null 2>&1; then
  export TERM='xterm-256color';
fi;

prompt_git() {
  local s='';
  # SOH/STX markers for readline (can't use \[...\] inside command substitution).
  local SOH=$'\001' STX=$'\002';

  # Check if the current directory is in a Git repository.
  if [ $(git rev-parse --is-inside-work-tree &>/dev/null; echo "${?}") == '0' ]; then

    # check if the current directory is in .git before running git checks
    if [ "$(git rev-parse --is-inside-git-dir 2> /dev/null)" == 'false' ]; then

      # Check for unstaged changes (orange ●).
      if ! $(git diff-files --quiet --ignore-submodules --); then
        s+="${SOH}${orange}${STX}●";
      fi;

      # Check for staged changes (green ●).
      if ! $(git diff --quiet --ignore-submodules --cached); then
        s+="${SOH}${green}${STX}●";
      fi;

      # Check for untracked files (red ●).
      if [ -n "$(git ls-files --others --exclude-standard)" ]; then
        s+="${SOH}${red}${STX}●";
      fi;

    fi;

    # Get bare branch name and output: (branch●●●)
    local branch;
    branch="$(__git_ps1 '%s')";
    printf "(%s%s%s%s)" "${SOH}${cyan}${STX}" "$branch" "$s" "${SOH}${reset}${STX}";

  else
    return;
  fi;
}

prompt_svn() {
  local s='';
  local SOH=$'\001' STX=$'\002';

  # Get name of current branch
  local svn_branch;
  svn_branch=$(parse_svn_branch)
  if [[ -n "${svn_branch}" ]]; then

    # Check if repository has uncommitted changes (orange ●).
    if [[ -n $(svn status -q) ]]; then
      s+="${SOH}${orange}${STX}●";
    fi;

    # parse_svn_branch returns " (branchname) " — extract just the name.
    local branch;
    branch=$(echo "$svn_branch" | sed 's/^ *(//;s/).*$//');
    printf "(%s%s%s%s)" "${SOH}${cyan}${STX}" "$branch" "$s" "${SOH}${reset}${STX}";

  else
    return;
  fi;
}

tput sgr0; # reset colors
bold=$(tput bold);
reset=$(tput sgr0);
# Solarized colors, taken from http://git.io/solarized-colors.
black=$(tput setaf 236);
blue=$(tput setaf 33);
cyan=$(tput setaf 37);
green=$(tput setaf 64);
orange=$(tput setaf 166);
purple=$(tput setaf 125);
red=$(tput setaf 124);
violet=$(tput setaf 61);
white=$(tput setaf 15);
yellow=$(tput setaf 136);

# Highlight the user name when logged in as root.
user_style() {
  if [[ "${USER}" == "root" ]]; then
    printf "${bold}${red}";
  else
    printf "${violet}";
  fi;
}

# Highlight the hostname when connected via SSH.
host_style() {
  #if [[ "${SSH_TTY}" ]]; then
  #	printf "${bold}${red}";
  #else
  printf "${yellow}";
  #fi;
}

dir_style() {
  printf "${green}";
}

# Set the terminal title to the current working directory.
PS1="\n";
PS1+="\[\033]0;\w\007\]";
PS1+="\[\$(user_style)\]\u"; # username
PS1+="\[${reset}\] at ";
PS1+="\[\$(host_style)\]\h"; # host
PS1+="\[${reset}\] in ";
PS1+="\[\$(dir_style)\]\w"; # working directory
PS1+="\[${reset}\] \$(prompt_git)\$(prompt_svn)"; # git/svn status
PS1+="\n";
PS1+="\[${white}\]\$ \[${reset}\]";
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;
