#!/bin/bash

source "$(dirname $BASH_SOURCE)/git-prompt.bash"
source "$(dirname $BASH_SOURCE)/svn-prompt.bash"

# SVN
SVNP_HUGE_REPO_EXCLUDE_PATH="nufw-svn$|/tags$|/branches$"

# Shell prompt based on the Solarized Dark theme.
# Screenshot: http://i.imgur.com/EkEtphC.png
# Heavily inspired by @necolas’s prompt: https://github.com/necolas/dotfiles
# iTerm → Profiles → Text → use 13pt Monaco with 1.1 vertical spacing.

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
  export TERM='gnome-256color';
elif infocmp xterm-256color >/dev/null 2>&1; then
  export TERM='xterm-256color';
fi;

prompt_git() {
  local s='';

  # Check if the current directory is in a Git repository.
  if [ $(git rev-parse --is-inside-work-tree &>/dev/null; echo "${?}") == '0' ]; then

    # check if the current directory is in .git before running git checks
    if [ "$(git rev-parse --is-inside-git-dir 2> /dev/null)" == 'false' ]; then

      # Ensure the index is up to date.
      git update-index --really-refresh -q &>/dev/null;

      # Check for uncommitted changes in the index.
      if ! $(git diff --quiet --ignore-submodules --cached); then
	s+='+';
      fi;

      # Check for unstaged changes.
      if ! $(git diff-files --quiet --ignore-submodules --); then
	s+='!';
      fi;

      # Check for untracked files.
      if [ -n "$(git ls-files --others --exclude-standard)" ]; then
	s+='?';
      fi;

      # Check for stashed files.
      if $(git rev-parse --verify refs/stash &>/dev/null); then
	s+='$';
      fi;

    fi;

    [ -n "${s}" ] && s=" [${s}]";

    printf "$(__git_ps1)${1}${s}";

  else
    return;
  fi;
}

prompt_svn() {
  local s='';

  # Get name of current branch
  svn=$(parse_svn_branch)
  if [[ ! -z "${svn}" ]]; then

    # Check if repository has uncommitted changes
    if [[ ! -z $(svn status -q) ]]; then
      s+='!';
    fi;

    [ -n "${s}" ] && s=" [${s}]";

    printf "${svn}${1}${s}";

  else
    return;
  fi;

}

tput sgr0; # reset colors
bold=$(tput bold);
reset=$(tput sgr0);
# Solarized colors, taken from http://git.io/solarized-colors.
black=$(tput setaf 236);
blue=$(tput setaf 33);
cyan=$(tput setaf 37);
green=$(tput setaf 64);
orange=$(tput setaf 166);
purple=$(tput setaf 125);
red=$(tput setaf 124);
violet=$(tput setaf 61);
white=$(tput setaf 15);
yellow=$(tput setaf 136);

# Highlight the user name when logged in as root.
user_style() {
  if [[ "${USER}" == "root" ]]; then
    printf "${bold}${red}";
  else
    printf "${bold}${orange}";
  fi;
}

# Highlight the hostname when connected via SSH.
host_style() {
  #if [[ "${SSH_TTY}" ]]; then
  #	printf "${bold}${red}";
  #else
  printf "${yellow}";
  #fi;
}

dir_style() {
  if [[ $(ls -ld "$PWD" | awk '{print $3}') == "${USER}" ]]; then
    printf "${green}";
  else
    printf "${bold}${cyan}";
  fi;
}

# Set the terminal title to the current working directory.
PS1="\n";
PS1+="\[\033]0;\w\007\]";
PS1+="\$(user_style)\u"; # username
PS1+="\[${reset}${black}\] @ ";
PS1+="\$(host_style)\h"; # host
PS1+="\[${reset}${black}\] : ";
PS1+="\$(dir_style)\w"; # working directory
PS1+="\[${reset}${violet}\]\$(prompt_git \"\[${blue}\]\")"; # Git repository details
PS1+="\[${reset}${purple}\]\$(prompt_svn \"\[${blue}\]\")"
PS1+="\[${reset}${black}\] (\@)"; # time
PS1+="\n";
PS1+="\[${white}\]"
PS1+='\$'
PS1+=" \[${reset}\]"; # `$` (and reset color)
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;
