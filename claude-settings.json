{
  "statusLine": {
    "type": "command",
    "command": "$HOME/.dotfiles/scripts/claude-statusline.sh",
    "padding": 0
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/scripts/claude-stop-hook.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "allowedTools": [
    "mcp__chrome-devtools__*"
  ]
}
