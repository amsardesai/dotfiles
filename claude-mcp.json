{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "codex": {
      "command": "codex",
      "args": ["mcp-server"]
    },
    "notion": {
      "type": "http",
