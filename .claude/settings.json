{
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Edit(file:README.md)",
      "Edit(file:USER_PREFERENCES.md)",
      "Edit(file:AGENTS.md)",
      "Edit(file:.claude/CLAUDE.md)",
      "Edit(file:CHANGELOG.md)",
      "Edit(file:KEYBINDINGS.md)",
      "Edit(file:TROUBLESHOOTING.md)",
      "Write(file:README.md)",
      "Write(file:USER_PREFERENCES.md)",
      "Write(file:AGENTS.md)",
      "Write(file:.claude/CLAUDE.md)",
      "Write(file:CHANGELOG.md)",
      "Write(file:KEYBINDINGS.md)",
      "Write(file:TROUBLESHOOTING.md)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/commit-push-hook.sh"
          }
        ]
      }
    ]
  }
}
